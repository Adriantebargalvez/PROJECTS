<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FctApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="9.2.0" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\proyecto\Models\*.cs" Link="Models\%(Filename)%(Extension)" />
    <Compile Include="..\proyecto\Services\DatabaseService.cs" Link="Services\DatabaseService.cs" />
    <Compile Include="..\proyecto\Services\IFctDataService.cs" Link="Services\IFctDataService.cs" />
  </ItemGroup>
</Project>
