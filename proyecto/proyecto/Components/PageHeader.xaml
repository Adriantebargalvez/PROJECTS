<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="proyecto.Components.PageHeader"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
        <Label
            Text="{Binding TitleText, Source={x:Reference Root}}"
            Style="{StaticResource PageTitleLabel}" />
        <Label
            Grid.Row="1"
            Text="{Binding SubtitleText, Source={x:Reference Root}}"
            Style="{StaticResource PageSubtitleLabel}" />
    </Grid>
</ContentView>
