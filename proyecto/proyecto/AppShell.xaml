<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="proyecto.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:proyecto.Views"
    FlyoutBehavior="Flyout"
    Title="FCT Manager">

    <FlyoutItem Title="Dashboard" Route="dashboard">
        <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Empresas" Route="empresas">
        <ShellContent ContentTemplate="{DataTemplate views:CompaniesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Confirmadas" Route="confirmadas">
        <ShellContent ContentTemplate="{DataTemplate views:ConfirmedCompaniesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Alumnos" Route="alumnos">
        <ShellContent ContentTemplate="{DataTemplate views:StudentsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Asignación" Route="asignacion">
        <ShellContent ContentTemplate="{DataTemplate views:AssignmentPage}" />
    </FlyoutItem>
</Shell>
