<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="proyecto.Components.StatCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        Padding="16"
        BackgroundColor="{StaticResource SurfaceColor}"
        Stroke="{StaticResource BorderSoftColor}"
        StrokeThickness="1">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="8" />
        </Border.StrokeShape>
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14">
            <Border
                Grid.RowSpan="3"
                WidthRequest="42"
                HeightRequest="42"
                BackgroundColor="{Binding AccentColor, Source={x:Reference Root}}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label
                    Text="{Binding Icon, Source={x:Reference Root}}"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="13"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />
            </Border>

            <Label
                Grid.Column="1"
                Text="{Binding TitleText, Source={x:Reference Root}}"
                Style="{StaticResource CaptionLabel}" />
            <Label
                Grid.Row="1"
                Grid.Column="1"
                Text="{Binding ValueText, Source={x:Reference Root}}"
                Style="{StaticResource MetricLabel}" />
            <Label
                Grid.Row="2"
                Grid.Column="1"
                Text="{Binding DetailText, Source={x:Reference Root}}"
                Style="{StaticResource MutedLabel}" />
        </Grid>
    </Border>
</ContentView>
